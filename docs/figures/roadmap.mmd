%% formal-martingales planned theorem sequence
%% Render: mmdc -i docs/figures/roadmap.mmd -o docs/figures/roadmap.png -b white -s 2
flowchart LR
    V["1. Ville<br/>finite-horizon + anytime<br/>M, done"]
    D1["2. Doob maximal<br/>finite-horizon API<br/>S, done"]
    E["3. e-values /<br/>e-processes API<br/>S, done"]
    AZ["4. Azuma-Hoeffding<br/>time-uniform (M)<br/>next"]
    FB["5. Freedman / Bernstein<br/>anytime (L)"]
    CS["6. confidence<br/>sequences (M to L)"]
    SLT["7. SLT bounds<br/>FormalSLT bridge (L)"]

    V --> D1 --> E --> AZ --> FB
    AZ --> CS
    FB --> CS
    E --> CS --> SLT

    classDef done fill:#d7f0d8,stroke:#2e7d32,stroke-width:2px,color:#1b1b1b;
    classDef next fill:#fdeecb,stroke:#e08e0b,stroke-width:2px,color:#1b1b1b;
    classDef planned fill:#e9ecef,stroke:#6c757d,stroke-width:2px,color:#1b1b1b;

    class V,D1,E done;
    class AZ next;
    class FB,CS,SLT planned;
